(() => {
  const root = document.documentElement;
  const key = 'blume-landing-appearance';
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const valid = value => ['system', 'light', 'dark'].includes(value);
  let preference = 'system';
  try {
    const saved = localStorage.getItem(key);
    if (valid(saved)) preference = saved;
  } catch {
    /* Appearance still works when storage is unavailable. */
  }
  const apply = () => {
    root.dataset.appearance = preference;
    root.dataset.theme =
      preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
    root.classList.toggle('dark', root.dataset.theme === 'dark');
    window.dispatchEvent(new Event('blume-appearance-change'));
  };
  window.addEventListener('blume-appearance-request', event => {
    if (!valid(event.detail)) return;
    preference = event.detail;
    try {
      localStorage.setItem(key, preference);
    } catch {
      /* Session-only choice. */
    }
    apply();
  });
  media.addEventListener('change', apply);
  window.addEventListener('storage', event => {
    if (event.key !== key && event.key !== null) return;
    preference = valid(event.newValue) ? event.newValue : 'system';
    apply();
  });
  apply();
})();
