</style><script type="module" src="/_astro/page.DGRhADao.js"></script></head> <body data-astro-cid-aq2yapxd> <main data-astro-cid-aq2yapxd> <header data-astro-cid-aq2yapxd><b data-astro-cid-aq2yapxd>acorn</b><span data-astro-cid-aq2yapxd>Checkout</span></header> <section data-astro-cid-aq2yapxd> <h1 data-astro-cid-aq2yapxd>Order summary</h1> <div class="product" data-astro-cid-aq2yapxd> <span class="thumb" aria-hidden="true" data-astro-cid-aq2yapxd><img src="/_astro/checkout-pass.W7fA_TEG.svg" alt="" data-astro-cid-aq2yapxd></span> <div data-astro-cid-aq2yapxd><strong data-astro-cid-aq2yapxd>Everyday tote</strong><small data-astro-cid-aq2yapxd>Sage · Qty 1</small></div> </div> <div id="gift" hidden data-astro-cid-aq2yapxd> <label class="choice" data-astro-cid-aq2yapxd><input type="checkbox" id="include-note" data-astro-cid-aq2yapxd> Add a gift note</label> <label id="message" hidden data-astro-cid-aq2yapxd><span class="sr" data-astro-cid-aq2yapxd>Gift note</span><textarea rows="2" maxlength="80" placeholder="Your message" data-astro-cid-aq2yapxd></textarea></label> </div> <div id="saved" hidden data-astro-cid-aq2yapxd><strong data-astro-cid-aq2yapxd>Gift note</strong><output data-astro-cid-aq2yapxd></output></div> <div class="total" data-astro-cid-aq2yapxd><strong data-astro-cid-aq2yapxd>Total</strong><b data-astro-cid-aq2yapxd>$48.00</b></div> <button type="button" data-astro-cid-aq2yapxd>Review order</button> </section> </main> <script>(function(){const GIFT_NOTE = "Happy birthday, Jo!";

      const main = document.querySelector('main');
      const checkbox = main.querySelector('#include-note');
      const note = main.querySelector('textarea');
      const action = main.querySelector('button');
      const view = new URL(location.href).searchParams.get('view');
      const legacy = view === 'before';
      const key = 'blume:checkout-gift-note';
      let reviewing = false;
      if (view === 'after') {
        checkbox.checked = true;
        note.value = GIFT_NOTE;
        history.replaceState(null, '', location.pathname);
      } else if (!legacy) {
        try {
          const saved = JSON.parse(sessionStorage.getItem(key) || '{}');
          checkbox.checked = saved.enabled === true;
          note.value = typeof saved.message === 'string' ? saved.message : '';
        } catch {}
      }
      function render() {
        main.querySelector('#gift').hidden = legacy || reviewing;
        main.querySelector('#message').hidden = !checkbox.checked;
        main.querySelector('#saved').hidden =
          legacy || !reviewing || !checkbox.checked || !note.value.trim();
        main.querySelector('output').textContent = note.value.trim();
        main.querySelector('h1').textContent = reviewing
          ? 'Review your order'
          : 'Order summary';
        action.textContent = reviewing ? 'Edit order' : 'Review order';
        if (!legacy) {
          try {
            sessionStorage.setItem(
              key,
              JSON.stringify({ enabled: checkbox.checked, message: note.value })
            );
          } catch {}
        }
      }
      checkbox.addEventListener('change', render);
      note.addEventListener('input', render);
      action.addEventListener('click', () => {
        reviewing = !reviewing;
        render();
      });
      render();
    })();</script> </body> </html> 