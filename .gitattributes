# Binaries must never be line-ending converted or diff-expanded.
* text=auto
*.node binary
*.exe binary
*.dll binary
*.pak binary
*.bin binary
*.dat binary
*.png binary
*.webp binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.wasm binary
*.zip binary
*.asar binary
# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
