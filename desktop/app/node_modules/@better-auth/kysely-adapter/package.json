      "default": "./dist/node-sqlite-dialect.mjs"
    }
  },
  "peerDependencies": {
    "@better-auth/utils": "0.4.2",
    "kysely": "^0.28.17 || ^0.29.0",
    "@better-auth/core": "^1.6.25"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250121.0",
    "@better-auth/utils": "0.4.2",
    "kysely": "^0.28.17 || ^0.29.0",
    "tsdown": "0.22.7",
    "typescript": "^6.0.3",
    "@better-auth/core": "1.6.25"
  }
}